# Copy to `.env` (gitignored) and fill in. Loaded automatically by `just index`
# (python-dotenv, from the repo root). Real shell exports / CI env still win for
# anything not listed here.

# --- Required for `just index` (local pipeline run) ---
# The Anthropic SDK reads this directly. Get one at:
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional tuning (defaults shown; uncomment to override) ---
# HACKERGIST_MODEL=claude-haiku-4-5
# HACKERGIST_ARTICLE_CHAR_BUDGET=12000  # article text truncated to this before summarizing
# HACKERGIST_GIST_MAX_TOKENS=70        # gists are one short line; raise for longer
# HACKERGIST_HOTNESS_GRAVITY=1.8        # backend doc-only; real sort is client-side
# HACKERGIST_EXTRACT_CONCURRENCY=6
# HACKERGIST_LOCAL_ROOT=.data           # local stand-in for the S3 bucket

# --- JS-render fallback (headless Chromium; needs `playwright install chromium`) ---
# HACKERGIST_RENDER_ENABLED=true        # set false to skip rendering (JS pages stay title-only)
# HACKERGIST_RENDER_CONCURRENCY=3       # concurrent browser pages (Chromium is memory-heavy)
# HACKERGIST_RENDER_TIMEOUT_MS=20000    # per-page navigation timeout
# HACKERGIST_RENDER_WAIT_MS=1500        # settle time after load for SPA hydration

# --- Lambda-only (do NOT set locally) ---
# HACKERGIST_BUCKET=...   # set by CDK in the deployed Lambda; locally the
#                         # FileSystem is LocalFileSystem(.data) instead of S3.
