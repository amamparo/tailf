# Copy to `.env` (gitignored) and fill in. Loaded automatically by `just index`
# (python-dotenv, from the repo root). Real shell exports / CI env still win for
# anything not listed here.

# --- Required for `just index` (local pipeline run) ---
# The Anthropic SDK reads this directly. Get one at:
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Hacker News source (official Firebase API; defaults shown) ---
# TAILF_TOP_LIMIT=40               # ids taken from topstories
# TAILF_BEST_LIMIT=30              # ids taken from beststories
# TAILF_ITEM_FETCH_CONCURRENCY=16  # concurrent item/<id>.json lookups
# TAILF_TOP_STORIES_URL / TAILF_BEST_STORIES_URL / TAILF_ITEM_URL  # override endpoints

# --- lobste.rs source (rss.rss for the list + hottest.json for scores) ---
# TAILF_LOBSTERS_ENABLED=true      # set false to drop lobste.rs entirely
# TAILF_LOBSTERS_RSS_URL=https://lobste.rs/rss.rss
# TAILF_LOBSTERS_HOTTEST_URL=https://lobste.rs/hottest.json
# TAILF_LOBSTERS_USER_AGENT=...    # defaults to the general polite UA

# --- Optional tuning (defaults shown; uncomment to override) ---
# TAILF_MODEL=claude-haiku-4-5
# TAILF_ARTICLE_CHAR_BUDGET=12000  # article text truncated to this before summarizing
# TAILF_GIST_MAX_TOKENS=70        # gists are one short line; raise for longer
# TAILF_HOTNESS_GRAVITY=1.8        # backend doc-only; real sort is client-side
# TAILF_EXTRACT_CONCURRENCY=6
# TAILF_LOCAL_ROOT=.data           # local stand-in for the S3 bucket

# --- JS-render fallback (headless Chromium; needs `playwright install chromium`) ---
# TAILF_RENDER_ENABLED=true        # set false to skip rendering (JS pages stay title-only)
# TAILF_RENDER_CONCURRENCY=3       # concurrent browser pages (Chromium is memory-heavy)
# TAILF_RENDER_TIMEOUT_MS=20000    # per-page navigation timeout
# TAILF_RENDER_WAIT_MS=1500        # settle time after load for SPA hydration

# --- Lambda-only (do NOT set locally) ---
# TAILF_BUCKET=...   # set by CDK in the deployed Lambda; locally the
#                         # FileSystem is LocalFileSystem(.data) instead of S3.
